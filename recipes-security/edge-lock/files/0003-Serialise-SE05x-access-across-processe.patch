     ENSURE_OR_GO_CLEANUP(pEcdsaCtx != NULL);
     ENSURE_OR_GO_CLEANUP(pEcdsaCtx->pStoreObjCtx != NULL);
     ENSURE_OR_GO_CLEANUP(sig != NULL);
@@ -907,6 +926,7 @@ cleanup:
     if (evpCtx != NULL) {
         EVP_PKEY_CTX_free(evpCtx);
     }
