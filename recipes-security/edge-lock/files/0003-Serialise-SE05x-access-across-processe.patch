 }
 
@@ -813,6 +829,9 @@ static int sss_ecdsa_signature_digest_verify_final(void *ctx, const unsigned cha
 
     sssProv_Print(LOG_DBG_ON, "Enter - %s \n", __FUNCTION__);
 
