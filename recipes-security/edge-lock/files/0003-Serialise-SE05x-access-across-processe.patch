 }
 
@@ -385,6 +389,9 @@ static int sss_ecdsa_signature_digest_sign_final(void *ctx, unsigned char *sig,
 
     sssProv_Print(LOG_DBG_ON, "Enter - %s \n", __FUNCTION__);
 
+    if (sssProv_xprocess_lock() != 0)
+        return 0;
