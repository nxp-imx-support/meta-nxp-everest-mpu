From 9775ce064397520c504682f6bf6c87bedc303361 Mon Sep 17 00:00:00 2001
From: Marouene Boubakri <marouene.boubakri@nxp.com>
Date: Wed, 22 Apr 2026 03:03:12 +0200
Subject: [PATCH] provider: Disable SE050 ECDH key exchange and enforce
 host-side generation

SE050 does not support transient (ephemeral) key generation, which makes
it unsuitable for handling ECDH key exchange during TLS handshakes.

Although the provider currently falls back to host-side ECDH key
generation at runtime, this behavior is implicit and relies on fallback
paths for a known hardware limitation.

This change disables SE05x key exchange support by default by:
- Introducing the SSS_PROV_DISABLE_SE05X_KEYEXCH build-time option
- Excluding OSSL_OP_KEYEXCH from the provider capabilities when enabled

With this change, ECDH key generation is always performed on the host,
while SE050 continues to be used for long-term private key operations
(e.g. signing). This results in predictable and deterministic TLS
behavior without relying on fallback mechanisms.

Upstream-Status: Pending

Signed-off-by: Marouene Boubakri <marouene.boubakri@nxp.com>
---
 CMakeLists.txt              | 1 +
 provider/sssProvider_main.c | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index c2aa079..b84c271 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -40,6 +40,7 @@ TARGET_INCLUDE_DIRECTORIES(
 
 ADD_DEFINITIONS(-DSSS_PROV_DISABLE_SE05X_RNG)
 #ADD_DEFINITIONS(-DSSS_PROV_GENERATE_RSA_PLAIN)
+ADD_DEFINITIONS(-DSSS_PROV_DISABLE_SE05X_KEYEXCH)
 
 ADD_CUSTOM_COMMAND(
     TARGET ${PROJECT_NAME}
diff --git a/provider/sssProvider_main.c b/provider/sssProvider_main.c
index 6182cc2..0e41501 100644
--- a/provider/sssProvider_main.c
+++ b/provider/sssProvider_main.c
@@ -175,8 +175,10 @@ static const OSSL_ALGORITHM *sss_query_operation(void *provctx, int operation_id
         return sss_signatures;
     case OSSL_OP_STORE:
         return sss_store;
+#ifndef SSS_PROV_DISABLE_SE05X_KEYEXCH
     case OSSL_OP_KEYEXCH:
         return sss_keyexchs;
+#endif
 #if SSS_HAVE_RSA
     case OSSL_OP_ASYM_CIPHER:
         return sss_rsa_enc;
