From d85663d40e21a0a0984a8ef3556bc613d21d5398 Mon Sep 17 00:00:00 2001
From: Marouene Boubakri <marouene.boubakri@nxp.com>
Date: Sun, 16 Nov 2025 04:54:16 +0100
Subject: [PATCH] IIOTSOL1-956: Rework OpenSSL provider loading to prioritize
 SE05x
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Updated CMake configuration to explicitly define the custom OpenSSL
provider (`nxp_prov`) and its associated property query string at
build time. The current CMake setup does not expose an easy way to
inject `CUSTOM_PROVIDER_NAME` them from the command line.

The change sets the following directly in CMakeLists.txt:
 - `CUSTOM_PROVIDER_NAME = "nxp_prov"`
 - `PROPQUERY_PROVIDER_CUSTOM = "?provider=${CUSTOM_PROVIDER_NAME}"`
 - `PROPQUERY_PROVIDER_DEFAULT = "?provider=default"`

The SE05x OpenSSL provider implements a hardware-backed `EVP_KEYMGMT`
and `EVP_SIGNATURE` interface that redirects private key operations
to the SE05x secure element. Using the `?provider=nxp_prov` property
query allows OpenSSL to prefer the SE05x provider for key and signature
operations while still falling back to the default provider for
algorithms that SE05x does not implement.

In OpenSSL property queries, `provider=nxp_prov` is a hard filter that
restricts algorithm selection strictly to provider `nxp_prov`.
This would break TLS handshakes if the provider lacks ciphers or
digests. In contrast, `?provider=nxp_prov` is a soft preference,
meaning OpenSSL will use algorithms from `nxp_prov` when available but
will transparently fall back to other providers (such as `default`)
when necessary.

In TLS integration, provider selection was attempted through explicit
property queries such as `provider=nxp_prov` or `?provider=nxp_prov`
when loading the private key or initializing the TLS context.
This approach failed because the SE05x provider does not include its
own PEM or DER decoders; it depends on the default provider’s generic
decoders to parse reference key files before identifying the embedded
SE05x key handle. When a strict property query was applied, OpenSSL
excluded the default provider’s decoders from the fetch process,
so the key could not be parsed at all.
Even with the relaxed `?provider=` form, the resulting key object was
still instantiated by the default provider, meaning that SE05x offload
was never engaged. The correct integration strategy is therefore to
avoid restrictive propqueries entirely and instead control algorithm
precedence by loading the SE05x provider before the default provider,
ensuring that it can claim reference keys once decoding has completed.

This behavior is required for SE05x-based setups to work with the default
provider.

Upstream-Status: Pending

Signed-off-by: Marouene Boubakri <marouene.boubakri@nxp.com>
---
 CMakeLists.txt                                |  8 ++++----
 .../crypto/openssl/openssl_provider.cpp       | 20 +++++++++----------
 2 files changed, 14 insertions(+), 14 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index adf4f20..3763dbc 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -27,18 +27,18 @@ if(USING_TPM2 AND USING_CUSTOM_PROVIDER)
 endif()
 
 if(USING_TPM2)
-    set(CUSTOM_PROVIDER_NAME "tpm2")    
+    set(CUSTOM_PROVIDER_NAME "tpm2")
 endif()
 
 if(USING_CUSTOM_PROVIDER)
-    set(CUSTOM_PROVIDER_NAME "custom_provider")    
+    set(CUSTOM_PROVIDER_NAME "nxp_prov")
 endif()
 
 if(USING_TPM2 OR USING_CUSTOM_PROVIDER)
 # OpenSSL property string when using the default provider
-    set(PROPQUERY_PROVIDER_DEFAULT "provider!=${CUSTOM_PROVIDER_NAME}")
+    set(PROPQUERY_PROVIDER_DEFAULT "?provider=default")
     # OpenSSL property string when using the tpm2/custom provider
-    set(PROPQUERY_PROVIDER_CUSTOM "?provider=${CUSTOM_PROVIDER_NAME},${CUSTOM_PROVIDER_NAME}.digest!=yes,${CUSTOM_PROVIDER_NAME}.cipher!=yes")
+    set(PROPQUERY_PROVIDER_CUSTOM "?provider=${CUSTOM_PROVIDER_NAME}")
 endif()
 
 # dependencies
diff --git a/lib/evse_security/crypto/openssl/openssl_provider.cpp b/lib/evse_security/crypto/openssl/openssl_provider.cpp
index 7f0452f..709295d 100644
--- a/lib/evse_security/crypto/openssl/openssl_provider.cpp
+++ b/lib/evse_security/crypto/openssl/openssl_provider.cpp
@@ -129,14 +129,14 @@ OpenSSLProvider::OpenSSLProvider() {
         }
 
         // load providers for global context
-        (void)load_global(mode_t::default_provider);
         (void)load_global(mode_t::custom_provider);
-        (void)set_propstr(nullptr, mode_t::default_provider);
+	(void)load_global(mode_t::default_provider);
+        //(void)set_propstr(nullptr, mode_t::default_provider);
 
         // load providers for tls context
+	(void)load_tls(mode_t::custom_provider);
         (void)load_tls(mode_t::default_provider);
-        (void)load_tls(mode_t::custom_provider);
-        (void)set_propstr(s_tls_libctx_p, mode_t::default_provider);
+        //(void)set_propstr(s_tls_libctx_p, mode_t::default_provider);
     }
 }
 
@@ -210,23 +210,23 @@ void OpenSSLProvider::cleanup() {
     // at the point this is called logging may not be available
     // relying on OpenSSL errors
     std::lock_guard guard(s_mux);
-    if (OSSL_PROVIDER_unload(s_tls_prov_custom_p) == 0) {
-        ERR_print_errors_fp(stderr);
-    }
     if (OSSL_PROVIDER_unload(s_tls_prov_default_p) == 0) {
         ERR_print_errors_fp(stderr);
     }
-    if (OSSL_PROVIDER_unload(s_global_prov_custom_p) == 0) {
+    if (OSSL_PROVIDER_unload(s_tls_prov_custom_p) == 0) {
         ERR_print_errors_fp(stderr);
     }
     if (OSSL_PROVIDER_unload(s_global_prov_default_p) == 0) {
         ERR_print_errors_fp(stderr);
     }
+    if (OSSL_PROVIDER_unload(s_global_prov_custom_p) == 0) {
+        ERR_print_errors_fp(stderr);
+    }
 
-    s_tls_prov_custom_p = nullptr;
     s_tls_prov_default_p = nullptr;
-    s_global_prov_custom_p = nullptr;
+    s_tls_prov_custom_p = nullptr;
     s_global_prov_default_p = nullptr;
+    s_global_prov_custom_p = nullptr;
 
     OSSL_LIB_CTX_free(s_tls_libctx_p);
 
-- 
