From 31e52e2550da80b47bba39fecd605f500e97b8dc Mon Sep 17 00:00:00 2001
From: Sachin Saxena <sachin.saxena@oss.nxp.com>
Date: Wed, 17 Sep 2025 16:26:21 +0530
Subject: [PATCH 08/10] Avoid power budget expiry

Upstream-Status: Pending
Signed-off-by: Sachin Saxena <sachin.saxena@oss.nxp.com>
---
 config/config-nxp-easyevse-basic-sigb-nfc-ocpp201.yaml     | 6 +++---
 config/config-nxp-easyevse-basic-sigb-ocpp-dummyToken.yaml | 6 +++---
 2 files changed, 6 insertions(+), 6 deletions(-)

diff --git a/config/config-nxp-easyevse-basic-sigb-nfc-ocpp201.yaml b/config/config-nxp-easyevse-basic-sigb-nfc-ocpp201.yaml
index a433ee0a..55e86b3e 100644
--- a/config/config-nxp-easyevse-basic-sigb-nfc-ocpp201.yaml
+++ b/config/config-nxp-easyevse-basic-sigb-nfc-ocpp201.yaml
@@ -184,9 +184,9 @@ active_modules:
       debug: false
       nominal_ac_voltage: 230
       schedule_interval_duration: 60
-      schedule_total_duration: 1
-      slice_ampere: 0.5
-      slice_watt: 500
+      slice_ampere: 1.0
+      slice_watt: 1000
+      schedule_total_duration: 5
       switch_3ph1ph_max_nr_of_switches_per_session: 0
       switch_3ph1ph_power_hysteresis_W: 200
       switch_3ph1ph_switch_limit_stickyness: DontChange
diff --git a/config/config-nxp-easyevse-basic-sigb-ocpp-dummyToken.yaml b/config/config-nxp-easyevse-basic-sigb-ocpp-dummyToken.yaml
index 99260561..307adf84 100644
--- a/config/config-nxp-easyevse-basic-sigb-ocpp-dummyToken.yaml
+++ b/config/config-nxp-easyevse-basic-sigb-ocpp-dummyToken.yaml
@@ -203,9 +203,9 @@ active_modules:
       debug: false
       nominal_ac_voltage: 230
       schedule_interval_duration: 60
-      schedule_total_duration: 1
-      slice_ampere: 0.5
-      slice_watt: 500
+      slice_ampere: 1.0
+      slice_watt: 1000
+      schedule_total_duration: 5
       switch_3ph1ph_max_nr_of_switches_per_session: 0
       switch_3ph1ph_power_hysteresis_W: 200
       switch_3ph1ph_switch_limit_stickyness: DontChange
