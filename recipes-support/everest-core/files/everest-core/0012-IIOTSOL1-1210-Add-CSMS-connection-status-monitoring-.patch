From 2482ae748004916106027f5d06bd3ee8c6b5d564 Mon Sep 17 00:00:00 2001
From: Lalit Saini <lalit.saini@nxp.com>
Date: Tue, 3 Mar 2026 10:59:21 +0530
Subject: [PATCH] IIOTSOL1-1210: Add CSMS connection status monitoring via MQTT
 publishing

Implement real-time CSMS connectivity monitoring by publishing
connection state changes to a dedicated MQTT topic. This enables
external systems and UIs to track charge point backend connectivity
without parsing EVerest's internal interface structure.

Changes:
- Publish connection status to 'everest_api/ocpp/csms_status' MQTT topic
- Maintain backward compatibility with existing publish_is_connected()

Technical Details:
- MQTT payload: true when connected, false when disconnected
- Topic: everest_api/ocpp/csms_status

Signed-off-by: Lalit Saini <lalit.saini@nxp.com>
---
 modules/EVSE/OCPP201/OCPP201.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/modules/EVSE/OCPP201/OCPP201.cpp b/modules/EVSE/OCPP201/OCPP201.cpp
index 8b8a9db6..7168adb5 100644
--- a/modules/EVSE/OCPP201/OCPP201.cpp
+++ b/modules/EVSE/OCPP201/OCPP201.cpp
@@ -854,6 +854,9 @@ void OCPP201::ready() {
                 ocpp_protocol_version = ocpp::OcppProtocolVersion::Unknown;
             }
             this->p_ocpp_generic->publish_is_connected(is_connected);
+            // Add direct MQTT publish for connection status
+            std::string connection_status_topic = "everest_api/ocpp/csms_status";
+            this->mqtt.publish(connection_status_topic, is_connected ? "true" : "false");
         };
 
     callbacks.security_event_callback = [this](const ocpp::CiString<50>& event_type,
