From 8d4ccfea54f11a0933e1008436d87bfdbcc863bd Mon Sep 17 00:00:00 2001
From: Lalit Saini <lalit.saini@nxp.com>
Date: Tue, 17 Feb 2026 13:07:21 +0530
Subject: [PATCH] IIOTSOL1-1210: Add CSMS connection status monitoring with
 MQTT publishing

What is changed:
- Added atomic boolean csms_connection_status to OCPP201 class to track CSMS connectivity state
- Enhanced connection_state_changed_callback to store and log connection status changes
- Added MQTT publishing to 'everest_api/ocpp/csms_status' topic with connection state

Why it is changed:
- Enable real-time monitoring of CSMS backend connectivity for external systems-UI

Technical context:
- Uses std::atomic<bool> for thread-safe access across callbacks
- MQTT topic publishes 'true'/'false' string values for connection state
- Maintains existing publish_is_connected() functionality

Signed-off-by: Lalit Saini <lalit.saini@nxp.com>
---
 modules/OCPP201/OCPP201.cpp | 12 +++++++++---
 modules/OCPP201/OCPP201.hpp |  2 ++
 2 files changed, 11 insertions(+), 3 deletions(-)

diff --git a/modules/OCPP201/OCPP201.cpp b/modules/OCPP201/OCPP201.cpp
index 8b8c85c51..9cc3e753d 100644
--- a/modules/OCPP201/OCPP201.cpp
+++ b/modules/OCPP201/OCPP201.cpp
@@ -775,9 +775,15 @@ void OCPP201::ready() {
     }
 
     callbacks.connection_state_changed_callback =
-        [this](const bool is_connected, const int /*configuration_slot*/,
-               const ocpp::v2::NetworkConnectionProfile& /*network_connection_profile*/,
-               const auto) { this->p_ocpp_generic->publish_is_connected(is_connected); };
+    [this](const bool is_connected, const int /*configuration_slot*/,
+           const ocpp::v2::NetworkConnectionProfile& /*network_connection_profile*/,
+           const auto) { 
+        this->csms_connection_status.store(is_connected);
+        EVLOG_info << "CSMS Connection: " << (is_connected ? "TRUE" : "FALSE");
+        this->p_ocpp_generic->publish_is_connected(is_connected);
+        this->mqtt.publish("everest_api/ocpp/csms_status", is_connected ? "true" : "false");
+    };
+
 
     callbacks.security_event_callback = [this](const ocpp::CiString<50>& event_type,
                                                const std::optional<ocpp::CiString<255>>& tech_info) {
diff --git a/modules/OCPP201/OCPP201.hpp b/modules/OCPP201/OCPP201.hpp
index 819696c39..89dada59a 100644
--- a/modules/OCPP201/OCPP201.hpp
+++ b/modules/OCPP201/OCPP201.hpp
@@ -122,6 +122,7 @@ private:
 
     // ev@211cfdbe-f69a-4cd6-a4ec-f8aaa3d1b6c8:v1
     // insert your private definitions here
+    std::atomic<bool> csms_connection_status{false};
     std::shared_ptr<device_model::EverestDeviceModelStorage> everest_device_model_storage;
     std::unique_ptr<TransactionHandler> transaction_handler;
     Everest::SteadyTimer charging_schedules_timer;
@@ -181,6 +182,7 @@ private:
     /// \brief This function updates the additionalIdToken of the additionalTokenInfo field with the evcc_id.
     void update_evcc_id_token(const int& evse_id, const std::string& evcc_id);
     // ev@211cfdbe-f69a-4cd6-a4ec-f8aaa3d1b6c8:v1
+    
 };
 
 // ev@087e516b-124c-48df-94fb-109508c7cda9:v1
