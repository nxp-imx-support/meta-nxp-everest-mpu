From 794407b5cdcb07b2c0129e9d7724f89a061f2103 Mon Sep 17 00:00:00 2001
From: Lalit Saini <lalit.saini@nxp.com>
Date: Tue, 3 Mar 2026 11:03:09 +0530
Subject: [PATCH] IIOTSOL1-1249: Block RFID authorization when EV not connected

What is changed:
- Added evse_ev_connected map to AuthHandler to track EV connection state per EVSE
- Modified on_token() to check EV connection status before processing RFID tokens
- Enhanced handle_session_event() to update connection state on SessionStarted/SessionFinished events
- Added logging for EV connection/disconnection events and blocked authorization attempts

Why it is changed:
- Prevent unauthorized charging sessions when no EV is physically connected
- Improve security by blocking RFID authorization without vehicle presence
- Align with charging station safety and security requirements

Technical context:
- Uses std::map<int32_t, bool> to track connection state per EVSE ID
- Returns TokenHandlingResult::NO_CONNECTOR_AVAILABLE when EV not connected
- Connection state updated based on SessionEventEnum events
- Thread-safe access protected by existing event_mutex

Signed-off-by: Lalit Saini <lalit.saini@nxp.com>
---
 modules/EVSE/Auth/include/AuthHandler.hpp |  1 +
 modules/EVSE/Auth/lib/AuthHandler.cpp     | 26 +++++++++++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/modules/EVSE/Auth/include/AuthHandler.hpp b/modules/EVSE/Auth/include/AuthHandler.hpp
index acac008a..8cbbd289 100644
--- a/modules/EVSE/Auth/include/AuthHandler.hpp
+++ b/modules/EVSE/Auth/include/AuthHandler.hpp
@@ -268,6 +268,7 @@ private:
     ReservationHandler reservation_handler;
 
     std::map<int, std::unique_ptr<EVSEContext>> evses;
+    std::map<int32_t, bool> evse_ev_connected;  // Track if EV is connected per EVSE
 
     std::list<int> plug_in_queue;
     std::set<ProvidedIdToken> tokens_in_process;
diff --git a/modules/EVSE/Auth/lib/AuthHandler.cpp b/modules/EVSE/Auth/lib/AuthHandler.cpp
index afbcbdf4..804ed8ad 100644
--- a/modules/EVSE/Auth/lib/AuthHandler.cpp
+++ b/modules/EVSE/Auth/lib/AuthHandler.cpp
@@ -89,6 +89,22 @@ TokenHandlingResult AuthHandler::on_token(const ProvidedIdToken& provided_token)
     EVLOG_info << "Received new token: " << everest::helpers::redact(provided_token);
     const auto referenced_evses = this->get_referenced_evses(provided_token);
 
+    // Check if EV is connected before processing token
+    bool ev_connected = false;
+    for (const auto& evse_id : referenced_evses) {
+        if (evse_ev_connected.find(evse_id) != evse_ev_connected.end() && evse_ev_connected[evse_id]) {
+            ev_connected = true;
+            break;
+        }
+    }
+
+    if (!ev_connected) {
+        EVLOG_warning << "RFID token received but EV not connected - ignoring authorization";
+        return TokenHandlingResult::NO_CONNECTOR_AVAILABLE;
+    }
+
+
+
     if (!this->is_token_already_in_process(provided_token, referenced_evses)) {
         // process token if not already in process
         this->tokens_in_process.insert(provided_token);
@@ -750,6 +766,16 @@ void AuthHandler::handle_session_event(const int evse_id, const SessionEvent& ev
     std::unique_lock<std::mutex> lk(this->event_mutex);
     // When connector id is not specified, it is assumed to be '1'.
     const int32_t connector_id = event.connector_id.value_or(1);
+
+    // Track EV connection state
+    if (event.event == SessionEventEnum::SessionStarted) {
+        evse_ev_connected[evse_id] = true;
+        EVLOG_info << "EV connected on EVSE#" << evse_id << " - ready for authorization";
+    } else if (event.event == SessionEventEnum::SessionFinished) {
+        evse_ev_connected[evse_id] = false;
+        EVLOG_info << "EV disconnected from EVSE#" << evse_id;
+    }
+
     if (evse_id <= 0) {
         EVLOG_error << "Handle session event: Evse id is <= 0: That should not be possible.";
         return;
-- 
