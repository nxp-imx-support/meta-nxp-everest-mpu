diff --git a/modules/EVSE/IsoMux/connection/tls_connection.cpp b/modules/EVSE/IsoMux/connection/tls_connection.cpp
index 4a44198..1cc4940 100644
--- a/modules/EVSE/IsoMux/connection/tls_connection.cpp
+++ b/modules/EVSE/IsoMux/connection/tls_connection.cpp
@@ -258,6 +258,54 @@ ssize_t connection_write(struct v2g_connection* conn, unsigned char* buf, std::s
     return (result < 0) ? result : static_cast<ssize_t>(bytes_written);
 }
 
+/**
+ * \brief Load a V2G leaf cert chain from one EvseSecurity instance into
+ *        the provided tls::Server::config_t. Appends one entry to
+ *        config.chains on success.
+ *
+ * Used by build_config() to populate one cert chain per wired
+ * EvseSecurity instance. OpenSSL selects from the resulting set of
+ * chains at ClientHello time based on the client EV's
+ * signature_algorithms extension.
+ *
+ * \param security The EvseSecurity interface to query. Must be non-null.
+ * \param config   The TLS server config to append the chain to.
+ * \param label    A human-readable label for log messages
+ *                 (e.g. "primary" / "secondary").
+ * \return true if a chain was successfully appended; false on any error.
+ */
+static bool load_cert_chain_from_security(evse_securityIntf* security,
+                                          tls::Server::config_t& config,
+                                          const char* label) {
+    const auto cert_info = security->call_get_leaf_certificate_info(
+        types::evse_security::LeafCertificateType::V2G,
+        types::evse_security::EncodingFormat::PEM, false);
+    if (cert_info.status != types::evse_security::GetCertificateInfoStatus::Accepted) {
+        dlog(DLOG_LEVEL_ERROR, "Failed to read cert_info (%s)! Not Accepted", label);
+        return false;
+    }
+    if (not cert_info.info) {
+        dlog(DLOG_LEVEL_ERROR, "Failed to read cert_info (%s)! Empty response", label);
+        return false;
+    }
+    const auto& info = cert_info.info.value();
+    auto& ref = config.chains.emplace_back();
+    ref.certificate_chain_file = info.certificate.value_or("").c_str();
+    ref.private_key_file = info.key.c_str();
+    ref.private_key_password = info.password.value_or("").c_str();
+
+    if (info.ocsp) {
+        for (const auto& ocsp : info.ocsp.value()) {
+            const char* file{nullptr};
+            if (ocsp.ocsp_path) {
+                file = ocsp.ocsp_path.value().c_str();
+            }
+            ref.ocsp_response_files.push_back(file);
+        }
+    }
+    return true;
+}
+
 bool build_config(tls::Server::config_t& config, struct v2g_context* ctx) {
     assert(ctx != nullptr);
     assert(ctx->r_security != nullptr);
@@ -294,39 +342,19 @@ bool build_config(tls::Server::config_t& config, struct v2g_context* ctx) {
 
     config.tls_key_logging = ctx->tls_key_logging;
 
-    // information from libevse-security
-    const auto cert_info =
-        ctx->r_security->call_get_leaf_certificate_info(LeafCertificateType::V2G, EncodingFormat::PEM, false);
-    if (cert_info.status != GetCertificateInfoStatus::Accepted) {
-        dlog(DLOG_LEVEL_ERROR, "Failed to read cert_info! Not Accepted");
-    } else {
-        if (cert_info.info) {
-            const auto& info = cert_info.info.value();
-            const auto cert_path = info.certificate.value_or("");
-            const auto key_path = info.key;
-
-            // workaround (see above libevse-security comment)
-            const auto key_password = info.password.value_or("");
-
-            auto& ref = config.chains.emplace_back();
-            ref.certificate_chain_file = cert_path.c_str();
-            ref.private_key_file = key_path.c_str();
-            ref.private_key_password = key_password.c_str();
-
-            if (info.ocsp) {
-                for (const auto& ocsp : info.ocsp.value()) {
-                    const char* file{nullptr};
-                    if (ocsp.ocsp_path) {
-                        file = ocsp.ocsp_path.value().c_str();
-                    }
-                    ref.ocsp_response_files.push_back(file);
-                }
-            }
-
-            bResult = true;
-        } else {
-            dlog(DLOG_LEVEL_ERROR, "Failed to read cert_info! Empty response");
-        }
+    // Load V2G leaf cert chain from the primary EvseSecurity. Existing
+    // single-EvseSecurity configs work as before.
+    bResult = load_cert_chain_from_security(ctx->r_security, config, "primary");
+
+    // If a secondary EvseSecurity is wired (typically because the
+    // deployment serves both ISO 15118-2 with one cert profile and
+    // ISO 15118-20 with another), also load its V2G leaf chain.
+    // OpenSSL will select at ClientHello time based on the EV's
+    // signature_algorithms.
+    if (ctx->r_security_secondary != nullptr) {
+        const bool secondary_ok =
+            load_cert_chain_from_security(ctx->r_security_secondary, config, "secondary");
+        bResult = bResult || secondary_ok;
     }
 
     return bResult;
