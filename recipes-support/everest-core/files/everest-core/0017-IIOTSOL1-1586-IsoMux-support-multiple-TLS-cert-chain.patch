@@ -34,7 +34,10 @@ namespace module {
 
 void IsoMux::init() {
     /* create v2g context */
-    v2g_ctx = v2g_ctx_create(&(*r_security));
+    // Pass the optional secondary EvseSecurity if wired in the config.
+    evse_securityIntf* secondary =
+        r_security_secondary.empty() ? nullptr : r_security_secondary[0].get();
+    v2g_ctx = v2g_ctx_create(&(*r_security), secondary);
 
     if (v2g_ctx == nullptr)
         return;
